# ─────────────────────────────────────────────────────────
#  이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채우세요.
#  로컬에서 돌릴 때만 씁니다. GitHub Actions 는 Secrets 를 읽습니다.
#
#  ⚠ 아래 값들은 전부 "예시"입니다. 그대로 두면 동작하지 않습니다.
#     제대로 채웠는지는  node scripts/doctor.mjs  로 확인하세요.
#  ⚠ .env 는 절대 커밋하지 마세요. (.gitignore 에 이미 들어 있습니다)
# ─────────────────────────────────────────────────────────


# ══ 연동 테스트에 필요한 것 ═══════════════════════════════

# ── 텔레그램 ──
# 토큰만 넣고  node scripts/telegram-setup.mjs  를 실행하면
# TELEGRAM_CHAT_ID 는 알아서 채워집니다.
TELEGRAM_BOT_TOKEN=123456789:AAE...
TELEGRAM_CHAT_ID=

# ── 인스타그램 ──
# 토큰만 넣고  node scripts/instagram-setup.mjs  를 실행하면
# IG_USER_ID 와 IG_API_BASE 는 알아서 채워집니다.
IG_ACCESS_TOKEN=IGAA...
IG_USER_ID=
IG_API_BASE=


# ══ 매일 자동 실행으로 넘어갈 때 추가할 것 ════════════════

# GitHub — 이미지 호스팅용 공개 레포에 쓰기 권한이 있는 토큰
#   config.json 의 imageHost 가 "github" 일 때만 필요합니다.
#   github.com → Settings → Developer settings
#   → Personal access tokens → Fine-grained tokens
#   권한: 해당 레포의 Contents = Read and write
# GITHUB_TOKEN=github_pat_...

# 카피 작성 수단 — 사람 없이 도는 스케줄 실행에만 필요합니다.
#   생성 모드(직접 카드 만들기)에서는 둘 다 없어도 됩니다.
#   둘 중 하나만 채우면 알아서 그쪽으로 실행됩니다.

# ① Claude 구독으로 실행 — 추가 요금 없음 (권장)
#    Pro / Max / Team / Enterprise 구독자라면 이쪽.
#    터미널에서  claude setup-token  실행 → 나온 토큰을 붙여넣기 (유효기간 1년)
# CLAUDE_CODE_OAUTH_TOKEN=

# ② Anthropic API 로 실행 — 토큰당 과금 (구독이 없을 때)
#    https://console.anthropic.com 에서 발급
# ANTHROPIC_API_KEY=sk-ant-...
# 비용을 더 아끼려면: claude-haiku-4-5
# ANTHROPIC_MODEL=claude-sonnet-5
